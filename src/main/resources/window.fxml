<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.projetov.controller.PedidoController"
            prefHeight="680.0" prefWidth="760.0"
            style="-fx-background-color: #f6f7f9;">

    <VBox spacing="14" AnchorPane.topAnchor="18" AnchorPane.leftAnchor="22"
          AnchorPane.rightAnchor="22" AnchorPane.bottomAnchor="18">

        <Label text="Novo Pedido de Chopp"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

        <TitledPane text="Dados do Pedido" collapsible="false"
                    style="-fx-font-weight: bold;">
            <GridPane hgap="12" vgap="10">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCliente" promptText="Nome ou Razao Social"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Entregador:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtEntregador" promptText="Nome do entregador"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Modalidade:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cmbTipoVenda"
                          promptText="PDV ou Venda Direta"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </TitledPane>

        <TitledPane text="Adicionar Barril" collapsible="false"
                    style="-fx-font-weight: bold;">
            <GridPane hgap="12" vgap="10">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="170"/>
                </columnConstraints>

                <Label text="Codigo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCodigoBarril" promptText="Ex: B50-001"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cmbTipoChopp" promptText="Selecione o tipo"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Capacidade:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cmbCapacidade" promptText="Selecione a capacidade"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <CheckBox fx:id="chkConsignado"
                          text="Barril consignado"
                          GridPane.columnIndex="1" GridPane.rowIndex="3"
                          style="-fx-text-fill: #6d28d9;"/>

                <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="4">
                    <Button text="Adicionar" onAction="#handleAdicionarBarril"
                            maxWidth="Infinity"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Remover selecionado" onAction="#handleRemoverBarril"
                            maxWidth="Infinity"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white;"/>
                </VBox>
            </GridPane>
        </TitledPane>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Barris no Pedido" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="lblResumoPedido" text="0 barris | 0 L"
                   style="-fx-text-fill: #4b5563;"/>
        </HBox>

        <TableView fx:id="tableBarris" prefHeight="210"
                   style="-fx-border-color: #cbd5e1; -fx-border-radius: 4;">
            <columns>
                <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="110"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
                <TableColumn fx:id="colLitros" text="Litros" prefWidth="80"/>
                <TableColumn fx:id="colPrecoLitro" text="Valor por litro" prefWidth="130"/>
                <TableColumn fx:id="colValorBarril" text="Valor por barril" prefWidth="140"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="115"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Label text="Total do pedido:"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotal" text="R$ 0,00"
                   style="-fx-font-size: 18px; -fx-text-fill: #15803d; -fx-font-weight: bold;"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Limpar" onAction="#handleLimpar" prefWidth="100"
                    style="-fx-background-color: #64748b; -fx-text-fill: white;"/>
            <Button text="Finalizar Pedido" fx:id="btnFinalizar"
                    onAction="#handleFinalizarPedido" prefWidth="160"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>

    </VBox>
</AnchorPane>
